generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(ATHLETE)
  password      String?
  emailVerified DateTime?
  // Feature flags (migrados de config.features)
  featurePlan      Boolean @default(true)
  featureCheckin   Boolean @default(true)
  featureNutrition Boolean @default(true)
  featureProgress  Boolean @default(true)
  featureLog       Boolean @default(true)
  featureCoach     Boolean @default(false)
  featureGym       Boolean @default(true)

  // Onboarding (migrado de config.onboarding)
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  // Google OAuth role selection (migrado de config === null check)
  needsRoleSelection Boolean @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription  UserSubscription?

  accounts          Account[]
  sessions          Session[]
  profile           HealthProfile?
  goals             Goal[]
  trainingPlans     TrainingPlan[]
  sessionLogs       SessionLog[]
  checkIns          WeeklyCheckIn[]
  nutritionPlan     NutritionPlan?
  coachOf           CoachAthlete[]    @relation("CoachRelation")
  coachedBy         CoachAthlete[]    @relation("AthleteRelation")

  // Gym feature
  exercises            Exercise[]        @relation("CoachExercises")
  workoutTemplates     WorkoutTemplate[] @relation("CoachTemplates")
  athleteTemplates     WorkoutTemplate[] @relation("AthleteTemplates")
  coachAssignments     AssignedWorkout[] @relation("CoachAssignments")
  athleteAssignments   AssignedWorkout[] @relation("AthleteAssignments")
  gymSessions          GymSession[]

  // Marketplace
  coachProfile       CoachProfile?

  // Métricas diarias
  dailyLogs          DailyLog[]

  // Nutrición personalizada
  foodProfile        FoodProfile?
  mealPlan           MealPlan?
  foodLogs           FoodLog[]

  // Invite codes
  inviteCodes        InviteCode[]  @relation("CoachInvites")

  // Benchmarks de rendimiento
  benchmarks         PerformanceBenchmark[]

  // Mensajería
  sentMessages       Message[] @relation("SentMessages")
  receivedMessages   Message[] @relation("ReceivedMessages")

  // Finanzas
  coachPayments      Payment[] @relation("CoachPayments")
  athletePayments    Payment[] @relation("AthletePayments")

  // Auditoría de pagos (acciones como actor)
  paymentAuditLogs   PaymentAuditLog[]
}

enum UserRole {
  ATHLETE
  COACH
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── COACH <> ATHLETE ───────────────────────────────────────────────────────

model CoachAthlete {
  id           String        @id @default(cuid())
  coachId      String
  athleteId    String
  status       AthleteStatus @default(ACTIVE)
  coachGoal    String?       // meta visible para el atleta (ej. "Bajar 5kg en 16 semanas")
  privateNotes String?       // notas privadas del coach — el atleta nunca las ve
  createdAt    DateTime      @default(now())

  coach   User @relation("CoachRelation",   fields: [coachId],   references: [id], onDelete: Cascade)
  athlete User @relation("AthleteRelation", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
}

enum AthleteStatus {
  ACTIVE
  PAUSED
}

// ─── INVITE CODES ───────────────────────────────────────────────────────────

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  coachId   String
  usedBy    String?   // athleteId que lo redimió
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  coach User @relation("CoachInvites", fields: [coachId], references: [id], onDelete: Cascade)
}

// ─── PERFIL DE SALUD ────────────────────────────────────────────────────────

model HealthProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  dateOfBirth    DateTime? @db.Date
  age            Int
  heightCm       Float
  weightKg       Float
  weightGoalKg   Float?
  hrResting      Int?
  hrMax          Int?
  ftp            Int?      // Cycling/Triathlon — Functional Threshold Power (watts)
  altitudeMeters Int?
  injuries       String[]
  conditions     String[]
  medications    String[]
  sleepHoursAvg  Float?
  sleepScoreAvg  Float?
  gender         String?   // male | female — afecta cálculo TDEE Mifflin-St Jeor (~166 kcal diferencia)
  // Sport-specific fields
  sport          String?   // RUNNING | CYCLING | SWIMMING | TRIATHLON | FOOTBALL | STRENGTH
  sportGoal      String?   // RACE | BODY_RECOMPOSITION | GENERAL_FITNESS (migrado de config.sport.goal)
  experienceLevel String?  // BEGINNER | INTERMEDIATE | ADVANCED
  sportDetails   Json      @default("{}")  // campos específicos por deporte
  // Fuente de cada dato — preparado para integraciones con dispositivos
  dataSources    Json      @default("{}")  // { hrMax: {source:'garmin', updatedAt:''}, ftp: {...} }
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── OBJETIVO ───────────────────────────────────────────────────────────────

model Goal {
  id             String     @id @default(cuid())
  userId         String
  type           GoalType
  raceDate       DateTime?
  targetTimeSecs Int?
  targetWeightKg Float?
  description    String?
  status         GoalStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlans TrainingPlan[]
}

enum GoalType {
  RACE_5K
  RACE_10K
  RACE_HALF_MARATHON
  RACE_MARATHON
  RACE_TRIATHLON
  RACE_CYCLING
  RACE_SWIMMING
  FOOTBALL_GPP
  STRENGTH_TRAINING
  BODY_RECOMPOSITION
  WEIGHT_LOSS
  GENERAL_FITNESS
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

// ─── PLAN DE ENTRENAMIENTO ──────────────────────────────────────────────────

model TrainingPlan {
  id          String     @id @default(cuid())
  userId      String
  goalId      String?
  name        String
  goalType    String?    // RACE_5K | RACE_10K | RACE_HALF_MARATHON | RACE_MARATHON | BODY_RECOMPOSITION | STRENGTH_TRAINING
  totalWeeks  Int
  startDate   DateTime
  endDate     DateTime
  status      PlanStatus @default(ACTIVE)
  hrZones     Json
  generatedBy PlanSource @default(AI)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  Goal?      @relation(fields: [goalId], references: [id])
  weeks PlanWeek[]

  @@index([userId, status])
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

enum PlanSource {
  AI
  COACH
  AI_COACH_APPROVED
}

model PlanWeek {
  id               String   @id @default(cuid())
  planId           String
  weekNumber       Int
  phase            Phase
  volumeKm         Float?
  focusDescription String?
  isRecoveryWeek   Boolean  @default(false)
  startDate        DateTime
  endDate          DateTime

  plan     TrainingPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions PlannedSession[]

  @@unique([planId, weekNumber])
}

enum Phase {
  BASE
  DESARROLLO
  ESPECIFICO
  AFINAMIENTO
}

model PlannedSession {
  id           String           @id @default(cuid())
  weekId       String
  dayOfWeek    Int
  type         SessionType
  intensity    SessionIntensity @default(MODERATE)
  durationMin  Int
  zoneTarget   String?
  structure    String?
  detailText   String?
  sportLabel   String?          // etiqueta libre por deporte: "Sweet Spot 2×20min", "CSS 400m × 8"
  coachNote    String?
  date         DateTime
  workoutDayId String?          // link to WorkoutDay when type=FUERZA

  week       PlanWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  log        SessionLog?
  workoutDay WorkoutDay? @relation(fields: [workoutDayId], references: [id])
  gymSession GymSession?

  @@index([weekId])
  @@index([date])
}

enum SessionIntensity {
  HIGH      // INTERVALOS, TIRADA_LARGA, SIMULACRO, TEST
  MODERATE  // TEMPO, FARTLEK, CICLA, NATACION, FUERZA
  LOW       // RODAJE_Z2, técnico/ligero
  REST      // DESCANSO
}

enum SessionType {
  RODAJE_Z2
  FARTLEK
  TEMPO
  INTERVALOS
  TIRADA_LARGA
  FUERZA
  CICLA
  NATACION
  DESCANSO
  TEST
  SIMULACRO
  OTRO
}

// ─── REGISTRO DE SESIÓN ─────────────────────────────────────────────────────

model SessionLog {
  id               String   @id @default(cuid())
  userId           String
  plannedSessionId String?  @unique
  completedAt      DateTime @default(now())
  rpe              Int?
  hrAvg            Int?
  hrMax            Int?
  distanceKm       Float?
  durationMin      Int?
  notes            String?
  garminActivityId String?
  freeSessionType  String?   // solo para logs libres (plannedSessionId = null): RODAJE_Z2 | FUERZA | OTRO

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedSession PlannedSession? @relation(fields: [plannedSessionId], references: [id])

  @@index([userId])
}

// ─── MÉTRICAS DIARIAS ───────────────────────────────────────────────────────

model DailyLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  weightKg    Float?
  hrResting   Int?
  sleepHours  Float?
  energyLevel Int?     // 1-5
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ─── CHECK-IN SEMANAL ───────────────────────────────────────────────────────

model WeeklyCheckIn {
  id                   String   @id @default(cuid())
  userId               String
  planId               String?  // null = sin plan activo (ISO week). Ver partial indexes en migration.
  weekNumber           Int
  recordedAt           DateTime @default(now())
  weightKg             Float?
  hrResting            Int?
  sleepHours           Float?
  sleepScore           Float?
  hardestSessionRpe    Int?
  dietAdherencePct     Int?
  painLevel            Int?     // 1-10: intensidad de dolor/molestia. painFlag derivado: painLevel >= 5
  painFlag             Boolean  @default(false)
  painDescription      String?  // descripción libre de la molestia/lesión reportada
  energyLevel          Int?     // 1-10 (normalizado desde ambas plataformas)
  stressLevel          Int?     // 1-10
  motivationLevel      Int?     // 1-10
  nutritionAdherencePct Int?    // 0-100: % adherencia al plan de comida (subjetivo)
  notes                String?
  adjustmentsTriggered String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unicidad manejada por dos partial indexes en SQL (ver migration fix_checkin_plan_scope):
  //   WHERE planId IS NOT NULL → unique (userId, planId, weekNumber)
  //   WHERE planId IS NULL     → unique (userId, weekNumber)
  // Prisma no soporta partial indexes en schema — se aplicaron manualmente.
  @@index([userId])
  @@index([planId])
}

// ─── GYM COACH FEATURE ──────────────────────────────────────────────────────

model Exercise {
  id           String   @id @default(cuid())
  coachId      String?  // null = librería global, string = ejercicio personalizado del coach
  name         String
  muscleGroups String[] // ["QUADRICEPS", "GLUTES", "HAMSTRINGS"]
  equipment    EquipmentType @default(BARBELL)
  category     ExerciseCategory @default(COMPOUND)
  description  String?
  tips         String?
  imageUrl     String?
  isGlobal     Boolean  @default(false) // true = librería base de Medaliq

  coach            User?             @relation("CoachExercises", fields: [coachId], references: [id])
  workoutExercises WorkoutExercise[]

  createdAt DateTime @default(now())
}

enum EquipmentType {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  SMITH
  BODYWEIGHT
  KETTLEBELL
  BAND
  OTHER
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
  CARDIO
  STRETCH
  FUNCTIONAL
}

model WorkoutTemplate {
  id          String  @id @default(cuid())
  coachId     String?   // null = plantilla pública del sistema o rutina del atleta
  athleteId   String?   // null = coach/sistema. string = rutina propia del atleta sin coach
  name        String
  description String?
  goal        String? // "HYPERTROPHY", "STRENGTH", "TONING", "FUNCTIONAL"
  level       String? // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  daysPerWeek Int     @default(3)
  isPublic    Boolean @default(false) // true = visible para todos los atletas
  isActive    Boolean @default(true)
  category    String? // "PPL", "FULL_BODY", "UPPER_LOWER", "STRENGTH", "BEGINNER"

  coach       User?            @relation("CoachTemplates", fields: [coachId], references: [id])
  athlete     User?            @relation("AthleteTemplates", fields: [athleteId], references: [id])
  days        WorkoutDay[]
  assignments AssignedWorkout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkoutDay {
  id           String   @id @default(cuid())
  templateId   String
  dayOfWeek    Int      // 1=Lunes … 7=Domingo
  label        String   // "Lunes — Cuádriceps y Gemelos"
  muscleGroups String[]
  isRestDay    Boolean  @default(false)
  warmupNotes  String?
  cardioNotes  String?
  order        Int      @default(0)

  template         WorkoutTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercises        WorkoutExercise[]
  plannedSessions  PlannedSession[]
}

model WorkoutExercise {
  id           String      @id @default(cuid())
  dayId        String
  exerciseId   String
  order        Int
  sets         Int         // 4
  repsScheme   String      // "12-15-18-20" | "12" | "hasta el fallo"
  restSeconds  Int?        // 90
  notes        String?
  setType      SetType     @default(NORMAL)
  supersetWith String?     // id de otro WorkoutExercise

  day      WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id])
  setLogs  SetLog[]
}

enum SetType {
  NORMAL
  SUPERSET
  BISERIE
  DROPSET
  CIRCUIT
}

model AssignedWorkout {
  id            String    @id @default(cuid())
  templateId    String
  athleteId     String
  coachId       String?   // null = auto-asignado por el atleta (sin coach)
  startDate     DateTime
  endDate       DateTime?
  weeksDuration Int?
  isActive      Boolean   @default(true)
  notes         String?

  template    WorkoutTemplate @relation(fields: [templateId], references: [id])
  athlete     User            @relation("AthleteAssignments", fields: [athleteId], references: [id])
  coach       User?           @relation("CoachAssignments", fields: [coachId], references: [id])
  gymSessions GymSession[]

  createdAt DateTime @default(now())

  @@index([athleteId, isActive])
}

model GymSession {
  id                String   @id @default(cuid())
  athleteId         String
  assignedWorkoutId String?  // null when session comes from a TrainingPlan (plannedSessionId set)
  plannedSessionId  String?  @unique  // link to PlannedSession — exclusive with assignedWorkoutId
  dayOfWeek         Int
  date              DateTime
  durationMin       Int?
  rpe               Int?     // 1-10
  notes             String?
  completed         Boolean  @default(false)

  exerciseOverrides Json?   // [{ originalWorkoutExerciseId, replacedWithExerciseId, replacedExerciseName, reason? }]

  athlete         User             @relation(fields: [athleteId], references: [id])
  assignedWorkout AssignedWorkout? @relation(fields: [assignedWorkoutId], references: [id])
  plannedSession  PlannedSession?  @relation(fields: [plannedSessionId], references: [id])
  setLogs         SetLog[]

  createdAt DateTime @default(now())

  @@unique([athleteId, date, assignedWorkoutId])  // legacy template-based sessions
  @@unique([athleteId, date, plannedSessionId])   // plan-based sessions
  @@index([athleteId, completed])
  @@index([athleteId, date])
}

model SetLog {
  id                String  @id @default(cuid())
  sessionId         String
  workoutExerciseId String?  // nullable — SetNull when coach edits/deletes exercise from routine
  exerciseName      String?  // desnormalized — preserves name even if WorkoutExercise is deleted
  setNumber         Int
  weightKg          Float?
  repsCompleted     Int?
  completed         Boolean @default(false)
  isPR              Boolean @default(false)
  notes             String?

  session         GymSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([workoutExerciseId])
}

// ─── MARKETPLACE DE COACHES ─────────────────────────────────────────────────

model CoachProfile {
  id             String   @id @default(cuid())
  coachId        String   @unique
  slug           String   @unique   // "carlos-entrenador"
  bio            String?
  avatarUrl      String?
  headline       String?            // "Especialista en media maratón y recomposición"
  specialties    String[]           // ["RUNNING", "GYM", "CYCLING", "TRIATHLON", "FUNCTIONAL"]
  city           String?
  country        String   @default("CO")
  whatsapp       String?
  instagram      String?
  yearsExp       Int?
  certifications String[]
  isPublic       Boolean  @default(false)

  coach    User           @relation(fields: [coachId], references: [id])
  programs CoachProgram[]
  posts    CoachPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachProgram {
  id            String   @id @default(cuid())
  profileId     String
  name          String   // "Plan Media Maratón — 18 semanas"
  description   String?
  sport         String   // "RUNNING", "GYM", "CYCLING", "TRIATHLON", "FUNCTIONAL"
  level         String   // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  durationWeeks Int?
  priceMonth    Float?   // USD/mes
  currency      String   @default("USD")
  includes      String[] // ["Plan personalizado", "Check-in semanal", "Chat directo"]
  isActive      Boolean  @default(true)

  profile CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model CoachPost {
  id        String   @id @default(cuid())
  profileId String
  type      PostType
  title     String
  body      String
  imageUrl  String?
  tags      String[]
  isPublic  Boolean  @default(true)

  profile CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum PostType {
  TIP
  ROUTINE_SHOWCASE
  ACHIEVEMENT
  ANNOUNCEMENT
}

// ─── PLAN NUTRICIONAL ───────────────────────────────────────────────────────

/// Singleton — siempre un solo registro con id = "singleton"
model SystemConfig {
  id        String   @id @default("singleton")
  aiProfile Json     @default("{}")   // AIProfile — perfil de la AI para planes y chat
  updatedAt DateTime @updatedAt
}

model NutritionPlan {
  id             String   @id @default(cuid())
  userId         String   @unique
  tdee           Int
  targetKcalHard Int
  targetKcalEasy Int
  targetKcalRest Int
  proteinG       Int
  carbsHardG     Int
  carbsEasyG     Int
  fatG           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── NUTRICIÓN PERSONALIZADA ─────────────────────────────────────────────────

model FoodProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  availableFoods   String[]
  availableFoodIds String[]  // IDs linkeados a Food.id — para cálculo de macros
  restrictions     String[]
  mealsPerDay    Int      @default(3)
  weighsFood     Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id          String   @id @default(cuid())
  userId      String   @unique
  data        Json     // { hard: DayMeals, easy: DayMeals, rest: DayMeals }
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── LIBRERÍA DE ALIMENTOS ──────────────────────────────────────────────────

model Food {
  id             String   @id @default(cuid())
  name           String
  category       String   // PROTEIN | CARB | FAT | VEGETABLE | FRUIT | DAIRY | LEGUME | NUT_SEED | OTHER
  // Macronutrientes por 100g
  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float
  // Micronutrientes por 100g (clave para atletas)
  fiberPer100g   Float?   // fibra (g)
  calciumMg      Float?   // calcio (mg)
  ironMg         Float?   // hierro (mg)
  potassiumMg    Float?   // potasio (mg)
  vitaminCMg     Float?   // vitamina C (mg)
  magnesiumMg    Float?   // magnesio (mg)
  sodiumMg       Float?   // sodio (mg)
  // Porción típica
  servingG       Float    @default(100) // gramos por porción típica
  servingLabel   String?               // "1 pechuga mediana", "2 cucharadas", etc.
  // Meta
  isVerified     Boolean  @default(true)  // false = enviado por comunidad, pendiente revisión
  createdBy      String?                  // null = sistema Medaliq
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  foodLogs FoodLog[]

  @@index([category])
  @@index([isActive])
}

// Registro diario de ingesta — listo para fase de tracking
model FoodLog {
  id       String   @id @default(cuid())
  userId   String
  foodId   String
  date     DateTime @db.Date
  mealType String   // BREAKFAST | LUNCH | DINNER | SNACK | PRE_WORKOUT | POST_WORKOUT
  grams    Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, foodId, date, mealType])
  @@index([userId, date])
}

model PerformanceBenchmark {
  id        String   @id @default(cuid())
  userId    String
  coachId   String?
  sport     String   // RUNNING | CYCLING | SWIMMING | STRENGTH | TRIATHLON
  metric    String   // 5K_TIME | 10K_TIME | HALF_MARATHON_TIME | MARATHON_TIME | FTP_WATTS | CSS_PACE | 1RM_SQUAT | 1RM_DEADLIFT | 1RM_BENCH | VO2MAX
  value     Float
  unit      String   // seconds | watts | kg | ml_kg_min
  testedAt  DateTime
  notes     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, sport])
  @@index([userId, metric, testedAt])
}

// ─── FINANZAS ────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  coachId     String
  athleteId   String
  amount      Float
  currency    String        @default("COP")
  description String?
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  coach   User @relation("CoachPayments",   fields: [coachId],   references: [id], onDelete: Cascade)
  athlete User @relation("AthletePayments", fields: [athleteId], references: [id], onDelete: Cascade)

  auditLogs PaymentAuditLog[]

  @@index([coachId, status])
  @@index([coachId, athleteId])
  @@index([dueDate, status])
}

enum PaymentStatus {
  PENDING
  PAID
}

model PaymentAuditLog {
  id        String   @id @default(cuid())
  paymentId String
  action    String   // CREATED | MARKED_PAID | REMINDED
  actorId   String
  note      String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// ─── SUSCRIPCIONES ───────────────────────────────────────────────────────────

enum SubscriptionTier {
  TRIAL
  FREE
  PRO
}

model UserSubscription {
  id                 String           @id @default(cuid())
  userId             String           @unique
  tier               SubscriptionTier @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  externalCustomerId String?          // Stripe/Wompi customer ID
  externalPriceId    String?          // Stripe/Wompi price ID
  cancelAtPeriodEnd  Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── MENSAJERÍA ──────────────────────────────────────────────────────────────

model Message {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  from User @relation("SentMessages",     fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ReceivedMessages", fields: [toId],   references: [id], onDelete: Cascade)

  @@index([fromId, toId, createdAt])
  @@index([toId, readAt])
}
